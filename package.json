{
  "name": "alloylogger-site",
  "private": true,
  "type": "module",
  "scripts": {
    "facts": "node worker/build-facts.mjs",
    "facts:fresh": "node worker/build-facts.mjs && git diff --exit-code worker/facts.generated.js",
    "test:harness": "node demo/js/robots/gen-fixture/harness.mjs",
    "test:ssl-data": "node demo/js/robots/gen-fixture/ssl-data.test.mjs",
    "test:ssl-script": "node demo/js/robots/gen-fixture/ssl-script.test.mjs",
    "test:battle-script": "node demo/js/robots/gen-fixture/battle-script.test.mjs",
    "test:battle-decode": "node demo/js/robots/gen-fixture/battle-decode.test.mjs",
    "test:battle-data": "node demo/js/robots/gen-fixture/battle-data.test.mjs",
    "test:ssl-leak": "node demo/js/robots/gen-fixture/ssl-leak-check.mjs",
    "test:ssl-leak:repo": "node demo/js/robots/gen-fixture/ssl-leak-check.mjs --repo",
    "test:ssl-leak:self": "node demo/js/robots/gen-fixture/ssl-leak-check.mjs --self-test",
    "test:ssl-leak:dev": "node demo/js/robots/gen-fixture/ssl-leak-check.mjs --dev-partial",
    "test:ssl-eager-size": "node demo/js/robots/gen-fixture/ssl-eager-size.test.mjs",
    "test:battle-eager-size": "node demo/js/robots/gen-fixture/battle-eager-size.test.mjs",
    "test:nav-race": "node demo/js/robots/gen-fixture/ssl-nav-race.test.mjs",
    "test:battle-lazy-path": "node demo/js/robots/gen-fixture/battle-lazy-path.test.mjs",
    "test:preview-fallback": "node demo/js/robots/gen-fixture/ssl-preview-fallback.test.mjs",
    "test:preview-roster": "node demo/js/robots/gen-fixture/ssl-preview-roster.test.mjs",
    "test:chart-absence": "node demo/js/robots/gen-fixture/ssl-chart-absence.test.mjs",
    "test:corrupt-meta": "node demo/js/robots/gen-fixture/ssl-corrupt-meta.test.mjs",
    "test:battle-hud": "node demo/js/robots/gen-fixture/battle-hud.test.mjs",
    "test": "npm run test:harness && npm run test:ssl-data && npm run test:ssl-script && npm run test:battle-script && npm run test:battle-decode && npm run test:battle-data && npm run test:ssl-eager-size && npm run test:battle-eager-size && npm run test:ssl-leak:self && npm run test:ssl-leak && npm run test:ssl-leak:repo && npm run test:nav-race && npm run test:battle-lazy-path && npm run test:preview-fallback && npm run test:preview-roster && npm run test:chart-absence && npm run test:corrupt-meta && npm run test:battle-hud && npm run facts:fresh",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
