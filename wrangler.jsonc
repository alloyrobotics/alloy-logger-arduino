{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // AlloyLogger landing page + demo. Static assets, plus /demo/api/chat (worker/chat.js).
  // Ingest lives in cloud/.
  "name": "alloylogger-site",
  "compatibility_date": "2026-07-02",
  // nodejs_compat: the Anthropic SDK reaches for node:stream / node:buffer on its fetch shim.
  // enable_request_signal: request.signal fires on client disconnect, so chat.js can abort the
  // upstream Anthropic stream instead of paying for an answer nobody will read.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "routes": [
    { "pattern": "alloylogger.com", "custom_domain": true },
    { "pattern": "www.alloylogger.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "main": "site-worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Personalized demo generator (worker/demo-gen.js + worker/do.js). One sqlite Durable
  // Object owns the whole funnel: job state machine, claim leases, dedupe, rate windows,
  // daily cap, published bundles, suppression list. KV has no CAS and a lost write here is
  // a lost lead, so none of that state lives anywhere else.
  // This Worker has never had a migration before, so v1 is the next free tag.
  "durable_objects": {
    "bindings": [{ "name": "DEMOGEN_DO", "class_name": "DemoGenDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoGenDO"] }],
  // Secrets (wrangler secret put, mirrored to pass alloylogger/*):
  //   DEMOGEN_TOKEN        bearer for /api/demo-gen/runner/* (the MBP poller)
  //   DEMOGEN_SIGNING_KEY  HMAC key for verify / approve / reject / unsubscribe links AND
  //                        for the keyed IP + email hashes, so raw IPs are never stored
  //   DEMOGEN_RESEND_KEY   Resend API key for the mail this Worker sends. The verification mail
  //                        went with the shelve; what uses this key today is the signup-lead
  //                        notification (worker/signup-lead.js), one plain-text email to Hugh per
  //                        NEW lead, budgeted at 25 a UTC day inside the DO
  // Optional dev-only vars, set via `wrangler dev --var`, never in this file:
  //   DEMOGEN_ORIGIN       link origin override (defaults to https://alloylogger.com)
  //   DEMOGEN_DEV_NO_EMAIL "1" logs the lead (and, historically, the verification link) instead of
  //                        calling Resend. Set it on every local run: an outbound Resend fetch
  //                        kills the local workerd process
  //   DEMOGEN_LEAD_DAILY_CAP overrides the 500/day global new-lead cap. `0` pauses the capture
  "vars": {
    "DEMOGEN_FROM": "Hugh at Alloy <hugh@alloylogger.com>",
    "DEMOGEN_MAX_JOBS_PER_DAY": "8"
  },
  "observability": {
    "enabled": true
  },
  // Rate limits. Two pairs, one per public endpoint, each an IP-keyed limiter plus a keyless
  // global one: the first stops a single visitor hammering the route, the second bounds the route
  // as a whole when one visitor is not the problem.
  // Limits are per-POP, not global; the real spend backstop is the Anthropic workspace cap.
  // namespace_id is an arbitrary per-account integer, and every one here is unique: reusing an id
  // would silently share one counter between two endpoints.
  // BOTH handlers fail CLOSED (503) if their bindings are missing; local dev sets DEV=1 instead.
  //   CHAT_* /demo/api/chat, a public endpoint spending a real API key.
  //   LEAD_* /api/signup-lead, a public endpoint that reaches the Durable Object on every post.
  //          Tighter than chat because a human fills this form once: 5/min per IP is already ten
  //          times the per-IP daily cap the DO enforces behind it.
  "ratelimits": [
    {
      "name": "CHAT_RL_IP",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "CHAT_RL_ALL",
      "namespace_id": "1002",
      "simple": { "limit": 150, "period": 60 }
    },
    {
      "name": "LEAD_RL_IP",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LEAD_RL_ALL",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
