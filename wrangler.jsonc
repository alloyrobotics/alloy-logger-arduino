{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // AlloyLogger landing page + demo. Static assets, plus /demo/api/chat (worker/chat.js).
  // Ingest lives in cloud/.
  "name": "alloylogger-site",
  "compatibility_date": "2026-07-02",
  // nodejs_compat: the Anthropic SDK reaches for node:stream / node:buffer on its fetch shim.
  // enable_request_signal: request.signal fires on client disconnect, so chat.js can abort the
  // upstream Anthropic stream instead of paying for an answer nobody will read.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "routes": [
    { "pattern": "alloylogger.com", "custom_domain": true },
    { "pattern": "www.alloylogger.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "main": "site-worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Personalized demo generator (worker/demo-gen.js + worker/do.js). One sqlite Durable
  // Object owns the whole funnel: job state machine, claim leases, dedupe, rate windows,
  // daily cap, published bundles, suppression list. KV has no CAS and a lost write here is
  // a lost lead, so none of that state lives anywhere else.
  // This Worker has never had a migration before, so v1 is the next free tag.
  "durable_objects": {
    "bindings": [{ "name": "DEMOGEN_DO", "class_name": "DemoGenDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoGenDO"] }],
  // Secrets (wrangler secret put, mirrored to pass alloylogger/*):
  //   DEMOGEN_TOKEN        bearer for /api/demo-gen/runner/* (the MBP poller)
  //   DEMOGEN_SIGNING_KEY  HMAC key for verify / approve / reject / unsubscribe links AND
  //                        for the keyed IP + email hashes, so raw IPs are never stored
  //   DEMOGEN_RESEND_KEY   Resend API key for the one email this Worker sends (verification)
  // Optional dev-only vars, set via `wrangler dev --var`, never in this file:
  //   DEMOGEN_ORIGIN       link origin override (defaults to https://alloylogger.com)
  //   DEMOGEN_DEV_NO_EMAIL "1" logs the verification link instead of calling Resend
  "vars": {
    "DEMOGEN_FROM": "Hugh at Alloy <hugh@alloylogger.com>",
    "DEMOGEN_MAX_JOBS_PER_DAY": "8"
  },
  "observability": {
    "enabled": true
  },
  // Rate limits for /demo/api/chat. It is a public endpoint spending a real API key, so both
  // limiters matter: the first stops one visitor hammering it, the second caps total burn.
  // Limits are per-POP, not global; the real spend backstop is the Anthropic workspace cap.
  // namespace_id is an arbitrary per-account integer — do not reuse these two elsewhere.
  // chat.js fails CLOSED (503) if these bindings are missing; local dev sets DEV=1 instead.
  "ratelimits": [
    {
      "name": "CHAT_RL_IP",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "CHAT_RL_ALL",
      "namespace_id": "1002",
      "simple": { "limit": 150, "period": 60 }
    }
  ]
}
